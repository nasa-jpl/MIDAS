FC=mpiifort

LDFLAGS= -Wl,--start-group  /cm/shared/apps/intel/oneapi/mkl/latest/lib/intel64/libmkl_blas95_lp64.a \
        /cm/shared/apps/intel/oneapi/mkl/latest/lib/intel64/libmkl_blacs_intelmpi_lp64.a \
        /cm/shared/apps/intel/oneapi/mkl/latest/lib/intel64/libmkl_lapack95_lp64.a \
        /cm/shared/apps/intel/oneapi/mkl/latest/lib/intel64/libmkl_scalapack_lp64.a \
        /cm/shared/apps/intel/oneapi/mkl/latest/lib/intel64/libmkl_intel_lp64.a \
        /cm/shared/apps/intel/oneapi/mkl/latest/lib/intel64/libmkl_core.a \
        /cm/shared/apps/intel/oneapi/mkl/latest/lib/intel64/libmkl_sequential.a \
        /cm/shared/apps/spack/opt/spack/linux-rhel9-sapphirerapids/oneapi-2023.2.0/hdf5-1.14.2-5v6orvlkvaeztm4ja23c3mobgfw25tqe/lib/libhdf5_f90cstub.a \
	    /cm/shared/apps/spack/opt/spack/linux-rhel9-sapphirerapids/oneapi-2023.2.0/hdf5-1.14.2-5v6orvlkvaeztm4ja23c3mobgfw25tqe/lib/libhdf5_cpp.a \
        /cm/shared/apps/spack/opt/spack/linux-rhel9-sapphirerapids/oneapi-2023.2.0/hdf5-1.14.2-5v6orvlkvaeztm4ja23c3mobgfw25tqe/lib/libhdf5_fortran.a \
        /cm/shared/apps/spack/opt/spack/linux-rhel9-sapphirerapids/oneapi-2023.2.0/hdf5-1.14.2-5v6orvlkvaeztm4ja23c3mobgfw25tqe/lib/libhdf5.a \-Wl,--end-group \
        -lz -lpthread -lm -ldl

FFLAGS= -f90=ifort -O3 -g -warn noalignments \
        -I /cm/shared/apps/intel/oneapi/mkl/latest/include/intel64/lp64 \
        -I /cm/shared/apps/intel/oneapi/mkl/latest/include \
	    -I /cm/shared/apps/spack/opt/spack/linux-rhel9-sapphirerapids/oneapi-2023.2.0/hdf5-1.14.2-5v6orvlkvaeztm4ja23c3mobgfw25tqe/include \

SOURCES=${wildcard *.f90}
OBJECTS=${SOURCES:.f90=.o}

%.o:%.f90
	${FC} -c ${FFLAGS} $^


midas: ${OBJECTS}
	${FC} -o midas ${OBJECTS} ${FFLAGS} ${LDFLAGS} 

clean:
	@-rm *.o *.mod midas

modules:
	${FC} -c ${FFLAGS} Initialization.f90 Common_variables.f90 stack_structure.f90 nrtype.f90 DiverseUtil.f90 precmod.f90 stringmod.f90
