FC=mpif90

LDFLAGS=-Wl,--start-group  $ /cm/shared/apps/intel/compilers_and_libraries_2019.5.281/linux/mkl/lib/intel64_lin/libmkl_blas95_lp64.a \
        $ /cm/shared/apps/intel/compilers_and_libraries_2019.5.281/linux/mkl/lib/intel64_lin/libmkl_blacs_intelmpi_lp64.a \
        $ /cm/shared/apps/intel/compilers_and_libraries_2019.5.281/linux/mkl/lib/intel64_lin/libmkl_lapack95_lp64.a \
        $ /cm/shared/apps/intel/compilers_and_libraries_2019.5.281/linux/mkl/lib/intel64_lin/libmkl_scalapack_lp64.a \
        $ /cm/shared/apps/intel/compilers_and_libraries_2019.5.281/linux/mkl/lib/intel64_lin/libmkl_intel_lp64.a \
        $ /cm/shared/apps/intel/compilers_and_libraries_2019.5.281/linux/mkl/lib/intel64_lin/libmkl_core.a \
        $ /cm/shared/apps/intel/compilers_and_libraries_2019.5.281/linux/mkl/lib/intel64_lin/libmkl_sequential.a \
        -Wl,--end-group -lpthread -lm -ldl
FFLAGS= -f90=ifort -O0 -g -traceback -check all -heap-arrays -warn noalignments \
        -I$ /cm/shared/apps/intel/compilers_and_libraries_2019.5.281/linux/mkl/include/intel64/lp64 \
        -I$ /cm/shared/apps/intel/compilers_and_libraries_2019.5.281/linux/mkl/include/

SOURCES=${wildcard *.f90}
OBJECTS=${SOURCES:.f90=.o}

%.o:%.f90
	${FC} -c ${FFLAGS} $^


midas: ${OBJECTS}
	${FC} -o nescop ${OBJECTS} ${FFLAGS} ${LDFLAGS} 

clean:
	@-rm *.o *.mod midas

modules:
	${FC} -c ${FFLAGS} Initialization.f90 common_variables.f90 stack_structure.f90 nrtype.f90 DiverseUtil.f90 precmod.f90 stringmod.f90
